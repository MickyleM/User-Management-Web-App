@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext

<div class="reset-modal">
    <div class="reset-card" @onclick:stopPropagation="true">
        @if(step == 1)
        {
            <label>Enter your email</label>
            <input type="email" value=@email @oninput="e => email = e.Value.ToString()" placeholder="Email" />

            @if (showError)
            {
                <p class="error-msg">Email not found. Please try again</p>
            }

            <div class="reset-footer">
                <button type="button" @onclick="Close">Cancel</button>
                <button type="button" class="btn-primary" @onclick="CheckEmail">Next</button>
            </div>
        }
        @if(step == 2)
        {
            <h3>Security Question</h3>
            <p>@securityQuestion</p>
            <label>Your answer:</label>
            <input type="text" value=@answer @oninput="e => answer = e.Value.ToString()" placeholder="Answer"/>

            @if(showError)
            {
                <p class="error-msg">Incorrect answer. Try again</p>
            }

            <div class="reset-footer">
                <button type="button" @onclick="Close">Cancel</button>
                <button type="button" class="btn-primary" @onclick="CheckAnswer">Submit</button>
            </div>
        }
        @if(step == 3)
        {
            <h3>Reseting Password</h3>
            <label>New Password</label>
            <input type="password" value=@newPassword @oninput="e => newPassword = e.Value.ToString()"" placeholder="New Password"/>
            <label>Confirm Password</label>
            <input type="password" value=@confirmPassword @oninput="e => confirmPassword = e.Value.ToString()" placeholder="Confirm Password"/>

            @if(showError)
            {
                <p>Passowrds do not match</p>
            }

            <div class="reset-footer">
                <button type="button" @onclick="Close">Cancel</button>
                <button type="button" class="btn-primary" @onclick="ResetPassword">Change Password</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private string email;
    private bool showError = false;
    private string newPassword = "";
    private string confirmPassword = "";
    private string securityQuestion = "";
    private User currentUser;
    private int step = 1;
    private string answer = "";

    private async Task CheckEmail()
    {
        showError = false;
        currentUser = await DbContext.Users.FirstOrDefaultAsync(u => u.email == email);
        if(currentUser == null)
        {
            showError = true;
            return;
        }

        var sq = await DbContext.SecurityQuestions.FirstOrDefaultAsync(q => q.UserId == currentUser.userID);
        if(sq == null)
        {
            showError = true;
            return;
        }

        securityQuestion = sq.question;
        step = 2;
    }

    private async Task CheckAnswer()
    {
        showError = false;
        var sq = await DbContext.SecurityQuestions.FirstOrDefaultAsync(q => q.UserId == currentUser.userID);

        if(!BCrypt.Net.BCrypt.Verify(answer, sq.answerHash))
        {
            showError = true;
            return;
        }

        step = 3;
    }

    private async Task ResetPassword(){
        showError = false;

        if(newPassword != confirmPassword)
        {
            showError = true;
            return;
        }

        currentUser.pword = BCrypt.Net.BCrypt.HashPassword(newPassword);
        await DbContext.SaveChangesAsync();

        await Close();
    }

    private async Task Close()
    {
        showError = false;
        step = 1;
        answer = "";
        newPassword = "";
        confirmPassword = "";
        email = "";
        currentUser = null;
        await OnClose.InvokeAsync();
    }
}
